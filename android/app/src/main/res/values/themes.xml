<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dos tintas sobre papel. Cian = acción, magenta = destructivo o error, índigo = cian × magenta:
         texto y líneas en registro. Las tramas de cian hacen de superficie. -->
    <color name="paper">#FFFAFCFD</color>
    <color name="sheet">#FFFFFFFF</color>
    <color name="ink">#FF001876</color>
    <color name="ink_2">#FF47588F</color>
    <color name="ink_3">#FF8E9AC0</color>
    <color name="rule">#24001876</color>
    <color name="cyan">#FF00B8D9</color>
    <color name="cyan_12">#FFE1F6FA</color>
    <color name="cyan_20">#FFCCF1F7</color>
    <color name="cyan_35">#FFA6E7F2</color>
    <color name="mag">#FFE0218A</color>
    <color name="mag_solid">#FFC4176F</color>
    <color name="mag_ink">#FFAD0D67</color>
    <color name="mag_12">#FFFCE6F2</color>

    <style name="AppTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:colorPrimary">@color/paper</item>
        <item name="android:colorPrimaryDark">@color/paper</item>
        <item name="android:colorAccent">@color/cyan</item>
        <item name="android:colorControlActivated">@color/ink</item>
        <item name="android:colorControlNormal">@color/ink_2</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/ink_2</item>
        <item name="android:textColorHint">@color/ink_3</item>
        <item name="android:textColorHighlight">@color/cyan_35</item>
        <item name="android:fontFamily">@font/barlow</item>
        <item name="android:statusBarColor">@color/paper</item>
        <item name="android:navigationBarColor">@color/paper</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:buttonStyle">@style/AppButton</item>
        <item name="android:switchStyle">@style/AppSwitch</item>
        <item name="android:alertDialogTheme">@style/AppDialog</item>
    </style>

    <!-- Sin MAYÚSCULAS forzadas, con el fondo propio y sin sombra -->
    <style name="AppButton" parent="@android:style/Widget.Material.Light.Button">
        <item name="android:background">@drawable/bg_tool</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/tool_text</item>
        <item name="android:fontFamily">@font/barlow_semibold</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:minWidth">44dp</item>
    </style>

    <style name="AppSwitch" parent="@android:style/Widget.Material.Light.CompoundButton.Switch">
        <item name="android:thumb">@drawable/bg_switch_thumb</item>
        <item name="android:track">@drawable/bg_switch_track</item>
        <item name="android:switchMinWidth">46dp</item>
        <item name="android:thumbTextPadding">0dp</item>
        <item name="android:switchPadding">8dp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:fontFamily">@font/barlow_semibold</item>
        <item name="android:minHeight">44dp</item>
    </style>

    <style name="AppDialog" parent="@android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="android:colorBackground">@color/paper</item>
        <item name="android:colorAccent">@color/cyan</item>
        <item name="android:colorControlActivated">@color/ink</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/ink_2</item>
        <item name="android:textColorAlertDialogListItem">@color/ink</item>
        <item name="android:switchStyle">@style/AppSwitch</item>
        <item name="android:windowTitleStyle">@style/DialogTitle</item>
        <item name="android:textAppearanceMedium">@style/DialogMessage</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/DialogPositive</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/DialogNegative</item>
        <item name="android:buttonBarNeutralButtonStyle">@style/DialogNegative</item>
    </style>

    <style name="DialogTitle">
        <item name="android:maxLines">1</item>
        <item name="android:fontFamily">@font/barlow_bold</item>
        <item name="android:textAppearance">@style/DialogTitleText</item>
    </style>

    <style name="DialogTitleText">
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:fontFamily">@font/barlow_bold</item>
    </style>

    <style name="DialogMessage">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/ink_2</item>
    </style>

    <style name="DialogNegative" parent="AppButton">
        <item name="android:textSize">16sp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:layout_marginStart">8dp</item>
    </style>

    <style name="DialogPositive" parent="DialogNegative">
        <item name="android:background">@drawable/bg_primary</item>
        <item name="android:textColor">@color/primary_text</item>
        <item name="android:fontFamily">@font/barlow_bold</item>
        <item name="android:layout_marginEnd">10dp</item>
    </style>

    <!-- La jerarquía la lleva la tipografía: sin mayúsculas forzadas ni color de acento -->
    <style name="Section">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/barlow_bold</item>
    </style>

    <style name="Rule">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:layout_marginBottom">14dp</item>
        <item name="android:background">@color/rule</item>
    </style>

    <style name="Muted">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/ink_2</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- Barra superior: texto con icono, sin fondo hasta tocarlo -->
    <style name="Flat" parent="AppButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:background">@drawable/bg_flat</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:drawablePadding">6dp</item>
        <item name="android:maxLines">1</item>
    </style>

    <style name="Tool" parent="AppButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!-- Solo icono: siempre con contentDescription y tooltipText -->
    <style name="IconBtn">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:background">@drawable/bg_flat</item>
        <item name="android:padding">10dp</item>
        <item name="android:scaleType">fitCenter</item>
    </style>

    <style name="BarIcon" parent="IconBtn">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
    </style>

    <style name="BarText" parent="AppButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:background">@drawable/bg_flat</item>
        <item name="android:paddingStart">6dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:drawablePadding">4dp</item>
    </style>

    <!-- Celda de la rejilla de edición: icono sobre etiqueta -->
    <style name="Cell" parent="AppButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">54dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">2dp</item>
        <item name="android:paddingTop">5dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:paddingStart">2dp</item>
        <item name="android:paddingEnd">2dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:drawablePadding">0dp</item>
        <item name="android:maxLines">1</item>
    </style>

    <style name="Primary" parent="AppButton">
        <item name="android:background">@drawable/bg_primary</item>
        <item name="android:textColor">@color/primary_text</item>
        <item name="android:fontFamily">@font/barlow_bold</item>
    </style>

    <!-- Etiqueta encima de un campo: se ve siempre (el hint desaparece al tener valor) -->
    <style name="FieldLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">3dp</item>
        <item name="android:textColor">@color/ink_2</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">@font/barlow_semibold</item>
        <item name="android:maxLines">1</item>
    </style>

    <style name="FieldBox">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:orientation">vertical</item>
    </style>

    <!-- focusable y clickable: un EditText creado por código con este estilo no hereda los de Widget.EditText -->
    <style name="Num">
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">true</item>
        <item name="android:clickable">true</item>
        <item name="android:longClickable">true</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:background">@drawable/bg_field</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">6dp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">@font/barlow_semibold</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:inputType">numberDecimal|numberSigned</item>
        <item name="android:imeOptions">actionDone</item>
        <item name="android:selectAllOnFocus">true</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="Seg">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">38dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/bg_seg_item</item>
        <item name="android:button">@null</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/seg_text</item>
        <item name="android:fontFamily">@font/barlow_semibold</item>
    </style>

    <style name="Strip">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">bottom</item>
        <item name="android:layout_margin">10dp</item>
        <item name="android:minHeight">76dp</item>
        <item name="android:background">@drawable/bg_strip</item>
        <item name="android:elevation">8dp</item>
        <item name="android:outlineSpotShadowColor">@color/ink</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">6dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
    </style>

    <style name="Arrow">
        <item name="android:layout_width">64dp</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:layout_margin">3dp</item>
        <item name="android:background">@drawable/bg_tool</item>
        <item name="android:padding">14dp</item>
        <item name="android:scaleType">fitCenter</item>
    </style>
</resources>

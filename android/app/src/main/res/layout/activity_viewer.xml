<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:orientation="vertical">

    <!-- barra superior -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <cl.digitalfox.cameolink.RegisterText
            android:id="@+id/wordmark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:contentDescription="@string/app_name" />

        <Button android:id="@+id/btnOpen" style="@style/Flat" android:drawableStart="@drawable/ic_folder_open" android:text="Abrir" />
        <Button android:id="@+id/btnAdd" style="@style/Flat" android:drawableStart="@drawable/ic_add" android:text="Agregar" android:visibility="gone" />
        <Button android:id="@+id/btnSave" style="@style/Flat" android:drawableStart="@drawable/ic_save" android:text="Guardar" android:visibility="gone" />

        <TextView
            android:id="@+id/fileName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:ellipsize="middle"
            android:fontFamily="@font/barlow_semibold"
            android:singleLine="true"
            android:text="Ningún archivo abierto"
            android:textColor="@color/ink_2"
            android:textSize="15sp" />

        <Button android:id="@+id/btnPrint" style="@style/Flat" android:drawableStart="@drawable/ic_print" android:text="Imprimir" android:visibility="gone" />

        <ImageButton
            android:id="@+id/btnTools"
            style="@style/IconBtn"
            android:contentDescription="Mostrar u ocultar herramientas"
            android:src="@drawable/ic_grid"
            android:tooltipText="Herramientas"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/connPill"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_pill"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingStart="9dp"
            android:paddingEnd="14dp">

            <cl.digitalfox.cameolink.RegisterMark
                android:id="@+id/connMark"
                android:layout_width="28dp"
                android:layout_height="28dp" />

            <TextView
                android:id="@+id/connText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="@font/barlow_semibold"
                android:fontFeatureSettings="tnum"
                android:maxLines="1"
                android:text="Sin conexión"
                android:textColor="@color/ink"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/rule" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <cl.digitalfox.cameolink.CanvasView
                android:id="@+id/canvas"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <LinearLayout
                android:id="@+id/emptyBox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <cl.digitalfox.cameolink.RegisterMark
                    android:id="@+id/emptyMark"
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/barlow_bold"
                    android:text="Abre un diseño para cortar"
                    android:textColor="@color/ink"
                    android:textSize="26sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="SVG · DXF · Silhouette .studio3"
                    android:textColor="@color/ink_2"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp">

                    <Button
                        android:id="@+id/btnOpen2"
                        style="@style/Primary"
                        android:layout_width="wrap_content"
                        android:layout_height="52dp"
                        android:paddingStart="22dp"
                        android:paddingEnd="22dp"
                        android:text="Abrir archivo"
                        android:textSize="16sp" />

                    <Button
                        android:id="@+id/btnBlank"
                        style="@style/AppButton"
                        android:layout_width="wrap_content"
                        android:layout_height="52dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_round"
                        android:paddingStart="22dp"
                        android:paddingEnd="22dp"
                        android:text="Hoja en blanco"
                        android:textSize="16sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- arriba a la izquierda: soporte, deshacer y escala -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_marginStart="10dp"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical">

                <Button
                    android:id="@+id/supportChip"
                    style="@style/AppButton"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_chip"
                    android:elevation="6dp"
                    android:fontFeatureSettings="tnum"
                    android:maxLines="1"
                    android:outlineSpotShadowColor="@color/ink"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/undoBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_bar"
                    android:elevation="6dp"
                    android:gravity="center_vertical"
                    android:outlineSpotShadowColor="@color/ink"
                    android:padding="2dp"
                    android:visibility="gone">

                    <ImageButton android:id="@+id/bUndo" style="@style/BarIcon" android:contentDescription="Deshacer" android:src="@drawable/ic_undo" android:tooltipText="Deshacer" />
                    <ImageButton android:id="@+id/bRedo" style="@style/BarIcon" android:contentDescription="Rehacer" android:src="@drawable/ic_redo" android:tooltipText="Rehacer" />
                    <View android:layout_width="1dp" android:layout_height="24dp" android:layout_marginStart="2dp" android:layout_marginEnd="8dp" android:background="@color/rule" />
                    <cl.digitalfox.cameolink.ScaleBar android:id="@+id/scaleBar" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="4dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- rejilla de herramientas: todas a la vista, sin scroll -->
            <LinearLayout
                android:id="@+id/editBar"
                android:layout_width="176dp"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_dock"
                android:elevation="6dp"
                android:orientation="vertical"
                android:outlineSpotShadowColor="@color/ink"
                android:padding="4dp"
                android:visibility="gone">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                    <Button android:id="@+id/bDup" style="@style/Cell" android:drawableTop="@drawable/ic_copy" android:text="Duplicar" />
                    <Button android:id="@+id/bFill" style="@style/Cell" android:drawableTop="@drawable/ic_grid" android:text="Rellenar" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                    <Button android:id="@+id/bRot" style="@style/Cell" android:drawableTop="@drawable/ic_rotate" android:text="Girar 90°" />
                    <Button android:id="@+id/bCenter" style="@style/Cell" android:drawableTop="@drawable/ic_center" android:text="Centrar" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                    <Button android:id="@+id/bFlipH" style="@style/Cell" android:drawableTop="@drawable/ic_flip_h" android:text="Reflejar ↔" />
                    <Button android:id="@+id/bFlipV" style="@style/Cell" android:drawableTop="@drawable/ic_flip_v" android:text="Reflejar ↕" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                    <Button android:id="@+id/bLayerUp" style="@style/Cell" android:drawableTop="@drawable/ic_up" android:text="Subir" />
                    <Button android:id="@+id/bLayerDown" style="@style/Cell" android:drawableTop="@drawable/ic_down" android:text="Bajar" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                    <Button android:id="@+id/bGroup" style="@style/Cell" android:drawableTop="@drawable/ic_link" android:text="Agrupar" />
                    <Button android:id="@+id/bDel" style="@style/Cell" android:background="@drawable/bg_cell_del" android:drawableTop="@drawable/ic_delete" android:drawableTint="@color/tool_danger_text" android:text="Eliminar" android:textColor="@color/tool_danger_text" />
                </LinearLayout>
            </LinearLayout>

            <!-- vista: abajo a la izquierda -->
            <LinearLayout
                android:id="@+id/viewBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_margin="10dp"
                android:background="@drawable/bg_bar"
                android:elevation="6dp"
                android:gravity="center_vertical"
                android:outlineSpotShadowColor="@color/ink"
                android:padding="2dp"
                android:visibility="gone">

                <ImageButton android:id="@+id/bZoomIn" style="@style/BarIcon" android:contentDescription="Acercar" android:src="@drawable/ic_add" android:tooltipText="Acercar" />
                <ImageButton android:id="@+id/bZoomOut" style="@style/BarIcon" android:contentDescription="Alejar" android:src="@drawable/ic_remove" android:tooltipText="Alejar" />
                <ImageButton android:id="@+id/bFit" style="@style/BarIcon" android:contentDescription="Ajustar a la pantalla" android:src="@drawable/ic_fit" android:tooltipText="Ajustar" />
                <View android:layout_width="1dp" android:layout_height="24dp" android:layout_marginStart="2dp" android:layout_marginEnd="2dp" android:background="@color/rule" />
                <Button android:id="@+id/bMulti" style="@style/BarText" android:drawableStart="@drawable/ic_multi" android:text="Múltiple" />
                <Button android:id="@+id/bAll" style="@style/BarText" android:drawableStart="@drawable/ic_select_all" android:text="Todo" />
            </LinearLayout>

            <!-- flotante abajo a la derecha: siempre a mano, con el panel abierto o cerrado -->
            <LinearLayout
                android:id="@+id/cutBox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_margin="10dp"
                android:gravity="end"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/summary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_summary"
                    android:elevation="6dp"
                    android:fontFeatureSettings="tnum"
                    android:outlineSpotShadowColor="@color/ink"
                    android:paddingStart="10dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="5dp"
                    android:textColor="@color/ink"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <ImageButton
                    android:id="@+id/bPanel"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_round"
                    android:contentDescription="Abrir o cerrar el panel"
                    android:elevation="6dp"
                    android:outlineSpotShadowColor="@color/ink"
                    android:src="@drawable/ic_chevron_right"
                    android:tooltipText="Panel" />

                <Button
                    android:id="@+id/bCut"
                    style="@style/Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="60dp"
                    android:elevation="6dp"
                    android:enabled="false"
                    android:minWidth="216dp"
                    android:outlineSpotShadowColor="@color/ink"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:text="Cortar"
                    android:textSize="17sp" />
            </LinearLayout>

            <LinearLayout android:id="@+id/progressBox" style="@style/Strip" android:visibility="gone">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/progressText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/barlow_semibold"
                        android:fontFeatureSettings="tnum"
                        android:maxLines="2"
                        android:text="Cortando…"
                        android:textColor="@color/ink"
                        android:textSize="16sp" />

                    <ProgressBar
                        android:id="@+id/progressBar"
                        style="@android:style/Widget.Material.Light.ProgressBar.Horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="10dp"
                        android:layout_marginTop="6dp"
                        android:max="1000"
                        android:progressDrawable="@drawable/bg_progress" />
                </LinearLayout>

                <Button
                    android:id="@+id/bStop"
                    style="@style/AppButton"
                    android:layout_width="wrap_content"
                    android:layout_height="64dp"
                    android:layout_marginStart="14dp"
                    android:background="@drawable/bg_danger"
                    android:fontFamily="@font/barlow_bold"
                    android:minWidth="132dp"
                    android:text="Detener"
                    android:textColor="#FFFFFFFF"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout android:id="@+id/resultBox" style="@style/Strip" android:visibility="gone">

                <ImageView
                    android:id="@+id/resMark"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_marginEnd="14dp"
                    android:background="@drawable/bg_round_ok"
                    android:importantForAccessibility="no"
                    android:padding="6dp"
                    android:src="@drawable/ic_check" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/resText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/barlow_semibold"
                        android:fontFeatureSettings="tnum"
                        android:textColor="@color/ink"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/resSub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLines="2"
                        android:textColor="@color/ink_2"
                        android:textSize="13sp" />
                </LinearLayout>

                <Button android:id="@+id/resAgain" style="@style/Tool" android:layout_height="60dp" android:layout_marginStart="10dp" android:minWidth="96dp" />
                <Button android:id="@+id/resClose" style="@style/Tool" android:layout_height="60dp" android:layout_marginStart="8dp" android:minWidth="84dp" android:text="Cerrar" />
            </LinearLayout>
        </FrameLayout>

        <View android:id="@+id/panelRule" android:layout_width="1dp" android:layout_height="match_parent" android:background="@color/rule" android:visibility="gone" />

        <!-- panel derecho (colapsable; sin documento no se muestra) -->
        <ScrollView
            android:id="@+id/sidePanel"
            android:layout_width="320dp"
            android:layout_height="match_parent"
            android:background="@color/paper"
            android:scrollbarThumbVertical="@color/cyan_35"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="8dp"
                android:paddingBottom="20dp">

                <LinearLayout
                    android:id="@+id/selSec"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView android:id="@+id/selTitle" style="@style/Section" android:layout_marginBottom="0dp" />

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                        <LinearLayout style="@style/FieldBox"><TextView style="@style/FieldLabel" android:text="X (mm)" /><EditText android:id="@+id/fx" style="@style/Num" /></LinearLayout>
                        <LinearLayout style="@style/FieldBox"><TextView style="@style/FieldLabel" android:text="Y (mm)" /><EditText android:id="@+id/fy" style="@style/Num" /></LinearLayout>
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                        <LinearLayout style="@style/FieldBox"><TextView style="@style/FieldLabel" android:text="Ancho (mm)" /><EditText android:id="@+id/fw" style="@style/Num" /></LinearLayout>
                        <LinearLayout style="@style/FieldBox"><TextView style="@style/FieldLabel" android:text="Alto (mm)" /><EditText android:id="@+id/fh" style="@style/Num" /></LinearLayout>
                    </LinearLayout>

                    <Switch
                        android:id="@+id/swLock"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:checked="true"
                        android:text="Mantener proporción" />

                    <View style="@style/Rule" />
                </LinearLayout>

                <TextView style="@style/Section" android:layout_marginEnd="8dp" android:text="Documento" />

                <LinearLayout
                    android:id="@+id/docRows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/docWarn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_warn"
                    android:fontFamily="@font/barlow_semibold"
                    android:padding="10dp"
                    android:textColor="@color/mag_ink"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <View style="@style/Rule" />

                <Switch
                    android:id="@+id/swPnc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:fontFamily="@font/barlow_bold"
                    android:minHeight="32dp"
                    android:text="Print &amp; Cut"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/pncLine"
                    style="@style/Muted"
                    android:layout_marginEnd="8dp"
                    android:fontFeatureSettings="tnum"
                    android:text="Leer marcas antes de cortar" />

                <LinearLayout
                    android:id="@+id/pncBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <RadioGroup
                        android:id="@+id/pncMode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_seg_track"
                        android:orientation="horizontal"
                        android:padding="3dp">

                        <RadioButton android:id="@+id/pncAuto" style="@style/Seg" android:checked="true" android:text="Automático" />
                        <RadioButton android:id="@+id/pncManual" style="@style/Seg" android:text="Manual" />
                    </RadioGroup>

                    <TextView
                        android:id="@+id/pncWarn"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_warn"
                        android:fontFamily="@font/barlow_semibold"
                        android:padding="10dp"
                        android:textColor="@color/mag_ink"
                        android:textSize="13sp"
                        android:visibility="gone" />

                    <Button
                        android:id="@+id/calibToggle"
                        style="@style/Flat"
                        android:layout_width="match_parent"
                        android:layout_marginTop="4dp"
                        android:layout_marginEnd="8dp"
                        android:drawableEnd="@drawable/ic_expand_more"
                        android:gravity="start|center_vertical"
                        android:paddingStart="0dp"
                        android:paddingEnd="0dp"
                        android:text="Calibración" />

                    <LinearLayout
                        android:id="@+id/calibBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                            <LinearLayout style="@style/FieldBox"><TextView style="@style/FieldLabel" android:text="Inset" /><EditText android:id="@+id/pInset" style="@style/Num" android:text="10" /></LinearLayout>
                            <LinearLayout style="@style/FieldBox"><TextView style="@style/FieldLabel" android:text="Inferior" /><EditText android:id="@+id/pInsetB" style="@style/Num" android:text="25" /></LinearLayout>
                            <LinearLayout style="@style/FieldBox"><TextView style="@style/FieldLabel" android:text="Grosor" /><EditText android:id="@+id/pThick" style="@style/Num" android:text="0.5" /></LinearLayout>
                        </LinearLayout>

                        <LinearLayout android:id="@+id/pSearchRow" android:layout_width="match_parent" android:layout_height="wrap_content">
                            <LinearLayout style="@style/FieldBox"><TextView style="@style/FieldLabel" android:text="Búsq. X" /><EditText android:id="@+id/pSearchX" style="@style/Num" android:text="-11" /></LinearLayout>
                            <LinearLayout style="@style/FieldBox"><TextView style="@style/FieldLabel" android:text="Búsq. Y" /><EditText android:id="@+id/pSearchY" style="@style/Num" android:text="-8" /></LinearLayout>
                            <LinearLayout style="@style/FieldBox"><TextView style="@style/FieldLabel" android:text="Calib. X" /><EditText android:id="@+id/pCalX" style="@style/Num" android:text="0" /></LinearLayout>
                            <LinearLayout style="@style/FieldBox"><TextView style="@style/FieldLabel" android:text="Calib. Y" /><EditText android:id="@+id/pCalY" style="@style/Num" android:text="0" /></LinearLayout>
                        </LinearLayout>

                        <Button android:id="@+id/bSearch" style="@style/Tool" android:layout_width="match_parent" android:layout_marginTop="8dp" android:layout_marginEnd="8dp" android:text="Probar búsqueda" />
                    </LinearLayout>
                </LinearLayout>

                <View style="@style/Rule" />

                <TextView style="@style/Section" android:layout_marginEnd="8dp" android:text="Material" />

                <Spinner
                    android:id="@+id/material"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_spinner"
                    android:popupBackground="@drawable/bg_summary" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                    <LinearLayout style="@style/FieldBox"><TextView style="@style/FieldLabel" android:text="Velocidad" /><EditText android:id="@+id/speed" style="@style/Num" android:inputType="number" /></LinearLayout>
                    <LinearLayout style="@style/FieldBox"><TextView style="@style/FieldLabel" android:text="Presión" /><EditText android:id="@+id/pressure" style="@style/Num" android:inputType="number" /></LinearLayout>
                    <LinearLayout style="@style/FieldBox"><TextView style="@style/FieldLabel" android:text="Pasadas" /><EditText android:id="@+id/passes" style="@style/Num" android:inputType="number" /></LinearLayout>
                </LinearLayout>

                <View style="@style/Rule" />

                <TextView style="@style/Section" android:layout_marginEnd="8dp" android:text="Cuchilla" />

                <TextView android:id="@+id/bladeName" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginEnd="8dp" android:fontFamily="@font/barlow_semibold" android:textColor="@color/ink" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                    <LinearLayout style="@style/FieldBox"><TextView android:id="@+id/offsetNote" style="@style/FieldLabel" android:text="Offset (mm)" /><EditText android:id="@+id/offset" style="@style/Num" /></LinearLayout>
                </LinearLayout>

                <Switch
                    android:id="@+id/swSharpen"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="Esquinas afiladas" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:orientation="vertical">

    <!-- Encabezado: volver al visor -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <Button android:id="@+id/btnBack" style="@style/Flat" android:drawableStart="@drawable/ic_chevron_left" android:text="Volver" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="@font/barlow_bold"
            android:text="Máquina"
            android:textColor="@color/ink"
            android:textSize="20sp" />
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/rule" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Lo de todos los días: estado y tres botones -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/cyan_20"
            android:orientation="vertical"
            android:padding="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <cl.digitalfox.cameolink.RegisterMark
                    android:id="@+id/mark"
                    android:layout_width="76dp"
                    android:layout_height="76dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/connState"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/barlow_bold"
                        android:maxLines="2"
                        android:text="Sin conexión"
                        android:textColor="@color/ink"
                        android:textSize="24sp" />

                    <TextView
                        android:id="@+id/machineState"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/barlow_semibold"
                        android:textColor="@color/ink_2"
                        android:textSize="15sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp">

                <Button
                    android:id="@+id/btnScan"
                    style="@style/Primary"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_weight="1"
                    android:text="Buscar Cameo"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/btnStatus"
                    style="@style/AppButton"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_round"
                    android:text="Estado"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/btnDisconnect"
                    style="@style/AppButton"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_round"
                    android:text="Desconectar"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>

        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbarThumbVertical="@color/cyan_35">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView android:id="@+id/foundTitle" style="@style/Section" android:text="Encontradas" />

                <LinearLayout
                    android:id="@+id/devBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <!-- Lo técnico, escondido -->
                <Button
                    android:id="@+id/btnAdvanced"
                    style="@style/Flat"
                    android:layout_width="match_parent"
                    android:layout_marginTop="6dp"
                    android:drawableEnd="@drawable/ic_expand_more"
                    android:gravity="start|center_vertical"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:text="Opciones avanzadas" />

                <LinearLayout
                    android:id="@+id/advBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                        <Button android:id="@+id/btnFirmware" style="@style/Tool" android:layout_width="0dp" android:layout_weight="1" android:text="Firmware" />
                        <Button android:id="@+id/btnInit" style="@style/Tool" android:layout_width="0dp" android:layout_marginStart="6dp" android:layout_weight="1" android:text="Inicializar" />
                        <Button android:id="@+id/btnChannels" style="@style/Tool" android:layout_width="0dp" android:layout_marginStart="6dp" android:layout_weight="1" android:text="Canales BLE" />
                    </LinearLayout>

                    <Button android:id="@+id/btnPython" style="@style/Tool" android:layout_width="match_parent" android:layout_marginTop="6dp" android:text="Probar lector SVG / DXF / studio3" />

                    <TextView style="@style/Section" android:layout_marginTop="16dp" android:text="Mover carro" />

                    <RadioGroup
                        android:id="@+id/stepGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_seg_track"
                        android:orientation="horizontal"
                        android:padding="3dp">

                        <RadioButton android:id="@+id/step1" style="@style/Seg" android:text="1 mm" />
                        <RadioButton android:id="@+id/step5" style="@style/Seg" android:text="5" />
                        <RadioButton android:id="@+id/step10" style="@style/Seg" android:checked="true" android:text="10" />
                        <RadioButton android:id="@+id/step50" style="@style/Seg" android:text="50" />
                    </RadioGroup>

                    <GridLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="8dp"
                        android:columnCount="3"
                        android:rowCount="3">

                        <Space android:layout_width="70dp" android:layout_height="58dp" />
                        <ImageButton android:id="@+id/btnUp" style="@style/Arrow" android:contentDescription="Papel hacia atrás" android:src="@drawable/ic_up" />
                        <Space android:layout_width="70dp" android:layout_height="58dp" />

                        <ImageButton android:id="@+id/btnLeft" style="@style/Arrow" android:contentDescription="Carro a la izquierda" android:src="@drawable/ic_chevron_left" />
                        <ImageButton android:id="@+id/btnHome" style="@style/Arrow" android:contentDescription="Volver al origen" android:src="@drawable/ic_center" />
                        <ImageButton android:id="@+id/btnRight" style="@style/Arrow" android:contentDescription="Carro a la derecha" android:src="@drawable/ic_chevron_right" />

                        <Space android:layout_width="70dp" android:layout_height="58dp" />
                        <ImageButton android:id="@+id/btnDown" style="@style/Arrow" android:contentDescription="Papel hacia adelante" android:src="@drawable/ic_down" />
                        <Space android:layout_width="70dp" android:layout_height="58dp" />
                    </GridLayout>

                    <TextView
                        android:id="@+id/position"
                        style="@style/Muted"
                        android:fontFeatureSettings="tnum"
                        android:gravity="center_horizontal"
                        android:text="X 0,0 · Y 0,0 mm desde el origen" />

                    <TextView style="@style/Section" android:layout_marginTop="16dp" android:text="Cuadrado de prueba, 20 mm" />

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="bottom">
                        <LinearLayout style="@style/FieldBox"><TextView style="@style/FieldLabel" android:text="Velocidad" /><EditText android:id="@+id/speed" style="@style/Num" android:inputType="number" android:text="10" /></LinearLayout>
                        <LinearLayout style="@style/FieldBox"><TextView style="@style/FieldLabel" android:text="Presión" /><EditText android:id="@+id/pressure" style="@style/Num" android:inputType="number" android:text="10" /></LinearLayout>
                        <Spinner android:id="@+id/mat" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1.4" android:background="@drawable/bg_spinner" android:popupBackground="@drawable/bg_summary" />
                    </LinearLayout>

                    <Button android:id="@+id/btnCut" style="@style/Primary" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:text="Cortar cuadrado" />

                    <TextView style="@style/Section" android:layout_marginTop="16dp" android:text="Comando manual" />

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                        <EditText
                            android:id="@+id/rawCmd"
                            style="@style/Num"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:fontFamily="monospace"
                            android:hint="FG   ·   hex:1b05"
                            android:imeOptions="actionSend"
                            android:inputType="textNoSuggestions|textVisiblePassword" />

                        <Button android:id="@+id/btnSend" style="@style/Tool" android:layout_marginStart="6dp" android:text="Enviar" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center_vertical">

                        <TextView style="@style/Section" android:layout_width="0dp" android:layout_marginBottom="0dp" android:layout_weight="1" android:text="Registro" />
                        <Button android:id="@+id/btnShare" style="@style/Tool" android:text="Compartir" />
                        <Button android:id="@+id/btnClear" style="@style/Tool" android:layout_marginStart="6dp" android:text="Limpiar" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/log"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_note"
                        android:fontFamily="monospace"
                        android:padding="8dp"
                        android:textColor="@color/ink"
                        android:textIsSelectable="true"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</LinearLayout>

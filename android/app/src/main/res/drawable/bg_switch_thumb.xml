<?xml version="1.0" encoding="utf-8"?>
<!-- Sin <inset>: Switch descuenta su relleno y el interruptor salía más chico que el dibujo -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><shape android:shape="oval"><solid android:color="#00000000" /><size android:width="26dp" android:height="28dp" /></shape></item>
    <item android:left="3dp" android:right="3dp" android:top="4dp" android:bottom="4dp"><shape android:shape="oval"><solid android:color="@color/ink" /></shape></item>
</layer-list>
